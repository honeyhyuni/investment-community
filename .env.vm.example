WEB_IMAGE=your-dockerhub-id/investment-community-web:latest
API_IMAGE=your-dockerhub-id/investment-community-api:latest
ENABLE_SCHEDULED_JOBS=true

WEB_BIND=0.0.0.0
API_BIND=0.0.0.0
GATEWAY_BIND=0.0.0.0
WEB_PORT=3000
API_PORT=4000
GATEWAY_PORT=80

WEB_ORIGIN=https://15f.kro.kr
NEXT_PUBLIC_API_BASE_URL=/api

POSTGRES_DB=invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://invest:change-me@postgres:5432/invest
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
FINNHUB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=

# PWA Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
ENABLE_WEB_PUSH=true
ENABLE_PUSH_TEST_API=false
